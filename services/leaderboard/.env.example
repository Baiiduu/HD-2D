# Native PostgreSQL deployment. start.ps1 uses SQLite for its default local config.
LEADERBOARD_DATABASE_URL=postgresql+psycopg://leaderboard@127.0.0.1:5432/leaderboard
LEADERBOARD_DATABASE_PASSWORD=replace-with-the-application-database-password
# Trusted server/admin credential. Never ship this in a game client.
LEADERBOARD_API_TOKEN=replace-with-a-random-token-at-least-32-characters
