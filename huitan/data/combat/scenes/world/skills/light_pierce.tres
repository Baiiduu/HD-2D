parameters = Dictionary[String, float]({
"damage_multiplier": 1.45,
"distance_multiplier": 1.25,
"extra_targets": 2.0,
"speed_multiplier": 1.4
})

[sub_resource type="Resource" id="Resource_1iooh"]
