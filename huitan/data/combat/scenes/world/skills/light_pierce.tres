[sub_resource type="Resource" id="Resource_ixtos"]
script = ExtResource("2_sopoj")
description = "雷光直线穿过敌群，每发对同一只敌人命中一次。"

[sub_resource type="Resource" id="Resource_1a0uj"]
script = ExtResource("2_sopoj")
