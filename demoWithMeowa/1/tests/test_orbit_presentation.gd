extends SceneTree

var checks := 0
var failures := 0

func check(value: bool, message: String) -> void:
	checks += 1
	if not value:
		failures += 1
		print("FAIL: ", message)

func group_kill_priority_checks() -> void:
	var focus: RefCounted = load("res://scripts/camera/ricochet_combat_focus.gd").new()
	var settings := RicochetCameraSettings.new()
	settings.combat_beat_enabled = true
	focus.begin_sword(Vector3.RIGHT, true)
	focus.sword_hit(Vector3.RIGHT, false)
	focus.advance(0.02, true, Vector3.ZERO, Vector3.RIGHT, settings)
	var weak := float(focus.pulse)
	var remaining := float(focus._cooldown)
	focus.storm_patch(Vector3.FORWARD, 6, 5)
	focus.advance(0.0, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.pulse > weak * 3.0 and focus.beat_count == 1, "普通命中后一帧奔雷群杀增强当前回弹，不被间隔吞掉")
	check(is_equal_approx(focus.age, 0.02) and is_equal_approx(focus._cooldown, remaining) and focus.recoil.z == 0.0, "群杀增强保留原时钟、剩余间隔和回弹方向")
	for index in 5:
		focus.storm_patch(Vector3.LEFT, 6, 5)
		focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 1 and is_equal_approx(focus.age, 0.07), "同等群杀不反复起播或延长这一下回弹")
	focus.reset()
	focus.begin_sword(Vector3.RIGHT, true)
	focus.sword_hit(Vector3.RIGHT, false)
	focus.advance(0.02, true, Vector3.ZERO, Vector3.RIGHT, settings)
	for index in 20:
		focus.begin_sword(Vector3.LEFT, true)
		for hit in 4: focus.sword_hit(Vector3.LEFT, false)
		focus.advance(0.005, true, Vector3.ZERO, Vector3.RIGHT, settings)
	for index in 30: focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 1 and focus.pulse == 0.0, "间隔内普通密集命中不反复起播，也不排队补抖")
	# 换一刀参与增强，之后原刀及该刀的后续目标仍合并在同一条时钟。
	focus.reset()
	focus.begin_sword(Vector3.RIGHT, true)
	focus.sword_hit(Vector3.RIGHT, false)
	focus.advance(0.02, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.begin_sword(Vector3.FORWARD, true)
	for index in 3: focus.sword_hit(Vector3.FORWARD, true)
	focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.pulse > weak * 2.0 and focus.beat_count == 1, "后续剑术群杀也可增强普通命中的回弹")
	focus.advance(0.08, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.sword_hit(Vector3.FORWARD, true)
	focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	for index in 30: focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 1 and focus.pulse == 0.0, "参与过增强的同刀后续目标不会在回稳末段排出第二次抖动")
	# 普通命中已经回稳时，最强群杀仅保留到共享间隔结束。
	focus.reset()
	focus.begin_sword(Vector3.RIGHT, true)
	focus.sword_hit(Vector3.RIGHT, false)
	focus.advance(0.02, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.advance(0.17, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.storm_patch(Vector3.FORWARD, 6, 5)
	focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 1, "回弹末段的群杀仍遵守原共享间隔")
	focus.begin_sword(Vector3.LEFT, true)
	focus.sword_hit(Vector3.LEFT, false)
	focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.advance(0.02, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 2 and focus.pulse > weak * 2.0 and focus.recoil.z > 0.0, "末段群杀保留最强一次，不被后来的普通命中覆盖")
	for index in 30: focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 2 and focus.pulse == 0.0, "群杀请求只消费一次，不在冷却后重放")
	focus.reset()
	focus.begin_sword(Vector3.RIGHT, true)
	focus.sword_hit(Vector3.RIGHT, false)
	focus.advance(0.02, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.advance(0.17, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.storm_patch(Vector3.FORWARD, 6, 5)
	focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	settings.combat_beat_enabled = false
	focus.advance(0.04, true, Vector3.ZERO, Vector3.RIGHT, settings)
	settings.combat_beat_enabled = true
	focus.advance(0.04, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 1 and focus.pulse == 0.0, "关闭表现立即丢弃待播群杀，重开不补发")
	focus.reset()
	check(focus.beat_count == 0 and focus.pulse == 0.0, "结束／重试清理群杀合并与待播状态")
	focus.begin_sword(Vector3.RIGHT, true)
	focus.sword_hit(Vector3.RIGHT, false)
	focus.advance(0.02, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.advance(0.17, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.storm_patch(Vector3.FORWARD, 6, 5)
	focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.reset()
	focus.advance(0.3, false, Vector3.ZERO, Vector3.ZERO, settings)
	check(focus.beat_count == 0 and focus.pulse == 0.0, "取消时清掉尚未播放的群杀请求，离场后不补抖")
	check(Engine.time_scale == 1.0, "群杀优先级处理保持世界原速")

func _initialize() -> void:
	var path := "res://scripts/camera/ricochet_combat_focus.gd"
	check(FileAccess.file_exists(path), "持续环绕与清群需要独立的只读表现状态")
	if not FileAccess.file_exists(path):
		quit(1)
		return
	var focus: RefCounted = load(path).new()
	var settings := RicochetCameraSettings.new()
	settings.set("orbit_focus_enabled", true)
	settings.set("combat_beat_enabled", true)
	for index in 45: focus.advance(1.0 / 60.0, true, Vector3.ZERO, Vector3(4, 0, 0), settings)
	check(focus.orbit_weight > 0.9 and focus.focus_offset.x > 0.0 and focus.focus_offset.length() <= 0.5, "整个环绕段持续保留怪群参照，人物保持近中心")
	var lead: Vector2 = focus.lead_goal(Vector2(0, 0.025), Basis.IDENTITY, 12.0)
	check(lead.x > 0.0 and absf(lead.y) < 0.01, "环绕取景收住切向前视并纳入怪群外沿")
	var old: Vector3 = focus.focus_offset
	focus.advance(1.0 / 60.0, true, Vector3.ZERO, Vector3(-4, 0, 0), settings)
	check(focus.focus_offset.distance_to(old) < 0.1, "群体轮廓更新不会让构图突然翻边")
	focus.begin_sword(Vector3.RIGHT, true)
	for index in 4: focus.sword_hit(Vector3(index * 0.2, 0, 0), true)
	focus.advance(0.03, true, Vector3.ZERO, Vector3.RIGHT, settings)
	var first := float(focus.pulse)
	check(first > 0.0 and focus.recoil.x < 0.0 and focus.beat_count == 1, "同刀四次击杀合并一次定向冲击")
	focus.sword_hit(Vector3.RIGHT, true)
	focus.advance(0.03, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 1 and focus.age > 0.04, "同刀后续扣血增强原反馈，不重置冲击时钟")
	for index in 30: focus.advance(1.0 / 60.0, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.begin_sword(Vector3.FORWARD, true)
	for index in 3: focus.sword_hit(Vector3.FORWARD, false)
	focus.advance(0.03, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 2 and focus.pulse > 0.0, "持续绕行后续真实攻击仍可形成重音，不仅首次接群")
	for index in 30: focus.advance(1.0 / 60.0, true, Vector3.ZERO, Vector3.RIGHT, settings)
	focus.storm_patch(Vector3.FORWARD, 3, 2)
	focus.advance(0.03, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 3 and focus.pulse > 0.0, "奔雷按真实命中片形成一次清群重音")
	focus.storm_patch(Vector3.LEFT, 5, 5)
	focus.advance(0.01, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.beat_count == 3, "同帧密集雷伤和剑伤服从共享间隔")
	for index in 120: focus.advance(1.0 / 60.0, false, Vector3.ZERO, Vector3.ZERO, settings)
	check(focus.orbit_weight < 0.001 and focus.focus_offset.length() < 0.001 and focus.pulse == 0.0, "离开环绕后平滑回到普通飞行取景")
	focus.reset()
	check(focus.beat_count == 0 and focus.pulse == 0.0 and focus.focus_offset == Vector3.ZERO, "重试／接管清理全部表现状态")
	settings.set("orbit_focus_enabled", false)
	settings.set("combat_beat_enabled", false)
	focus.begin_sword(Vector3.RIGHT, true)
	focus.sword_hit(Vector3.RIGHT, true)
	focus.advance(0.05, true, Vector3.ZERO, Vector3.RIGHT, settings)
	check(focus.orbit_weight == 0.0 and focus.pulse == 0.0, "地图独立关闭时保持原取景")
	check(Engine.time_scale == 1.0, "视觉状态不改世界时间或真实飞行规则")
	var world_settings: RicochetCameraSettings = load("res://data/combat/scenes/world/player/ricochet_camera.tres")
	var city_settings: RicochetCameraSettings = load("res://data/combat/scenes/city/player/ricochet_camera.tres")
	check(world_settings.orbit_focus_enabled and world_settings.combat_beat_enabled and not city_settings.orbit_focus_enabled and not city_settings.combat_beat_enabled, "持续环绕与清群取景由 World 独立开启，City 保持当前配置")
	var scene := Node3D.new()
	var player := Player.new()
	player.action_visuals = load("res://data/combat/scenes/world/player/action_visuals.tres")
	scene.add_child(player)
	player.owner = scene
	var camera := FollowCamera.new()
	camera.ricochet_camera_settings = world_settings
	scene.add_child(camera)
	camera.owner = scene
	var entries: Array[Dictionary] = load("res://addons/parameter_hub/catalog.gd").new().collect(scene)
	for property in ["orbit_focus_enabled", "orbit_lead_retention", "orbit_focus_weight", "orbit_focus_max_distance", "orbit_settle_seconds", "orbit_pullback_ratio", "combat_beat_enabled", "combat_beat_pixels", "combat_beat_seconds", "combat_beat_interval", "combat_pullback_ratio", "combat_readability_enabled", "combat_contact_frames", "combat_contact_seconds", "combat_sword_body_opacity", "combat_residue_opacity", "combat_death_focus_seconds"]:
		check(entries.any(func(item): return item.property == property and item.common and item.label != property), "参数总览提供持续表现的中文调节入口：" + property)
	scene.free()
	group_kill_priority_checks()
	print("Orbit presentation: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
