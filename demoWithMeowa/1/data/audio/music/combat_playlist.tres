[gd_resource type="Resource" script_class="BgmPlaylist" format=3]

[ext_resource type="Script" path="res://scripts/audio/bgm_playlist.gd" id="playlist"]
[ext_resource type="Script" path="res://scripts/audio/bgm_track.gd" id="track"]
[ext_resource type="Resource" path="res://data/audio/music/garden_battle.tres" id="battle"]

[resource]
resource_name = "战斗与波间曲池"
script = ExtResource("playlist")
context_id = &"combat"
tracks = Array[ExtResource("track")]([ExtResource("battle")])
