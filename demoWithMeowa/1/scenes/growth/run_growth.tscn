[ext_resource type="PackedScene" path="res://scenes/growth/experience_pickup.tscn" id="pickup"]
[ext_resource type="PackedScene" path="res://scenes/ui/growth_choice_ui.tscn" id="ui"]
[ext_resource type="Script" path="res://scripts/ui/growth_choice_option.gd" id="option"]
[ext_resource type="PackedScene" path="res://scenes/ui/experience_hud.tscn" id="experience_hud"]
[ext_resource type="Texture2D" path="res://assets/meowa/ui/experience/absorb.png" id="absorb"]

[sub_resource type="Resource" id="empty_a"]
script = ExtResource("option")
id = &"slot_a"

[sub_resource type="Resource" id="empty_b"]
