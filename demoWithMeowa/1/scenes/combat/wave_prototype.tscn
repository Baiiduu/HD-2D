[gd_scene load_steps=25 format=3]

[ext_resource type="Script" path="res://scripts/combat/wave_prototype.gd" id="wave"]
[ext_resource type="Resource" path="res://data/enemies/wave_slime.tres" id="slime"]
[ext_resource type="Resource" path="res://data/enemies/enemy_catalog.tres" id="enemy_catalog"]
[ext_resource type="PackedScene" path="res://scenes/combat/fan_auto_attack.tscn" id="fan"]
[ext_resource type="PackedScene" path="res://scenes/combat/light_pierce_auto_attack.tscn" id="pierce"]
[ext_resource type="PackedScene" path="res://scenes/combat/prism_ricochet_auto_attack.tscn" id="prism"]
[ext_resource type="PackedScene" path="res://scenes/combat/mirror_mark_auto_attack.tscn" id="mirror"]
[ext_resource type="PackedScene" path="res://scenes/combat/ricochet_storm.tscn" id="storm"]
[ext_resource type="PackedScene" path="res://scenes/ui/growth_choice_ui.tscn" id="choice"]
[ext_resource type="PackedScene" path="res://scenes/growth/run_growth.tscn" id="growth"]
[ext_resource type="PackedScene" path="res://scenes/ui/wave_hud.tscn" id="hud"]
[ext_resource type="PackedScene" path="res://scenes/combat/damage_numbers.tscn" id="damage_numbers"]
[ext_resource type="Script" path="res://scripts/growth/run_skills.gd" id="skills"]
[ext_resource type="Script" path="res://scripts/growth/run_buffs.gd" id="buffs"]
[ext_resource type="Script" path="res://scripts/growth/growth_buff_definition.gd" id="buff_definition"]
[ext_resource type="Resource" path="res://data/growth/damage.tres" id="damage_buff"]
[ext_resource type="Resource" path="res://data/growth/cooldown.tres" id="cooldown_buff"]
[ext_resource type="Resource" path="res://data/growth/range.tres" id="range_buff"]
[ext_resource type="Resource" path="res://data/growth/ricochet/launch_speed.tres" id="body_speed"]
[ext_resource type="Resource" path="res://data/growth/ricochet/flight_duration.tres" id="body_duration"]
[ext_resource type="Resource" path="res://data/growth/ricochet/charge_efficiency.tres" id="body_charge"]
[ext_resource type="Script" path="res://scripts/combat/run_score.gd" id="run_score"]
[ext_resource type="Resource" path="res://data/score/default_score.tres" id="score_rules"]
[ext_resource type="Script" path="res://scripts/ui/score_hud.gd" id="score_hud"]

[node name="WavePrototype" type="Node3D"]
script = ExtResource("wave")
default_enemy = ExtResource("slime")
enemy_catalog = ExtResource("enemy_catalog")

[node name="FanAutoAttack" parent="." node_paths=PackedStringArray("session") instance=ExtResource("fan")]
session = NodePath("..")

[node name="LightPierceAutoAttack" parent="." node_paths=PackedStringArray("session") instance=ExtResource("pierce")]
session = NodePath("..")

[node name="PrismRicochetAutoAttack" parent="." node_paths=PackedStringArray("session") instance=ExtResource("prism")]
session = NodePath("..")

[node name="MirrorMarkAutoAttack" parent="." node_paths=PackedStringArray("session") instance=ExtResource("mirror")]
session = NodePath("..")

[node name="RicochetStorm" parent="." node_paths=PackedStringArray("session") instance=ExtResource("storm")]
session = NodePath("..")

[node name="RunGrowth" parent="." node_paths=PackedStringArray("session") instance=ExtResource("growth")]
session = NodePath("..")

[node name="RunSkills" type="Node" parent="." node_paths=PackedStringArray("session")]
script = ExtResource("skills")
session = NodePath("..")
skill_paths = Array[NodePath]([NodePath("../FanAutoAttack"), NodePath("../LightPierceAutoAttack"), NodePath("../PrismRicochetAutoAttack"), NodePath("../MirrorMarkAutoAttack"), NodePath("../RicochetStorm")])

[node name="InitialSkillChoice" parent="RunSkills" instance=ExtResource("choice")]
title = "选择初始技能"
confirm_text = "开始战斗"

[node name="WaveHUD" parent="." node_paths=PackedStringArray("session") instance=ExtResource("hud")]
session = NodePath("..")

[node name="DamageNumbers" parent="." node_paths=PackedStringArray("session") instance=ExtResource("damage_numbers")]
session = NodePath("..")

[node name="RunBuffs" type="Node" parent="." node_paths=PackedStringArray("session")]
script = ExtResource("buffs")
session = NodePath("..")
definitions = Array[ExtResource("buff_definition")]([ExtResource("damage_buff"), ExtResource("cooldown_buff"), ExtResource("range_buff"), ExtResource("body_speed"), ExtResource("body_duration"), ExtResource("body_charge")])

[node name="RunScore" type="Node" parent="." node_paths=PackedStringArray("session")]
script = ExtResource("run_score")
session = NodePath("..")
rules = ExtResource("score_rules")

[node name="ScoreHUD" type="CanvasLayer" parent="." node_paths=PackedStringArray("score")]
script = ExtResource("score_hud")
score = NodePath("../RunScore")
